            "speaker_id": "speaker_9",
            "start_ms": 341227,
            "end_ms": 341513,
            "text": "нечно"
          },
          {
            "speaker_id": "speaker_3",
            "start_ms": 356296,
            "end_ms": 357460,
            "text": "Я какого-то чела убил."
          },
          {
            "speaker_id": "speaker_12",
            "start_ms": 359097,
            "end_ms": 359637,
            "text": "Молодец"
          },
          {
            "speaker_id": "speaker_12",
            "start_ms": 364497,
            "end_ms": 366151,
            "text": "Нет. Да"
          },
          {
            "speaker_id": "speaker_1",
            "start_ms": 366860,
            "end_ms": 367889,
            "text": "Согласен, нет"
          },
          {
            "speaker_id": "speaker_1",
            "start_ms": 371011,
            "end_ms": 373103,
            "text": "А может, и да? Вообще интересная тема"
