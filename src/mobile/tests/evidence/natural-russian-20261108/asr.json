          {
            "speaker_id": "speaker_11",
            "start_ms": 12181,
            "end_ms": 12974,
            "text": "Кно"
          },
          {
            "speaker_id": "speaker_12",
            "start_ms": 18374,
            "end_ms": 21175,
            "text": "ма! Мама, стой!"
          },
          {
            "speaker_id": "speaker_1",
            "start_ms": 22036,
            "end_ms": 25934,
            "text": "Я понял. И что вы делаете поэтом с этим"
          },
          {
            "speaker_id": "speaker_2",
            "start_ms": 28246,
            "end_ms": 28583,
            "text": "а"
