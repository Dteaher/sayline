          {
            "speaker_id": "speaker_4",
            "start_ms": 185960,
            "end_ms": 186803,
            "text": "Покажи."
          },
          {
            "speaker_id": "speaker_4",
            "start_ms": 189183,
            "end_ms": 189757,
            "text": "Закрой звен"
