            "speaker_id": "speaker_4",
            "start_ms": 295158,
            "end_ms": 297335,
            "text": "Я больше не могу писать сообщения."
          },
          {
            "speaker_id": "speaker_3",
            "start_ms": 298010,
            "end_ms": 299883,
            "text": "Бог Ккалий закрыл мне"
