            "speaker_id": "speaker_4",
            "start_ms": 78500,
            "end_ms": 79107,
            "text": "Или да"
          },
          {
            "speaker_id": "speaker_4",
            "start_ms": 82887,
            "end_ms": 84389,
            "text": "Давай"
          },
          {
            "speaker_id": "speaker_10",
            "start_ms": 83022,
            "end_ms": 83798,
            "text": "Давай"
          },
          {
            "speaker_id": "speaker_4",
            "start_ms": 85047,
            "end_ms": 87190,
            "text": "Только теперь просто выживание, давай"
