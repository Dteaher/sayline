            "speaker_id": "speaker_4",
            "start_ms": 244263,
            "end_ms": 244668,
            "text": "НуН"
          },
          {
            "speaker_id": "speaker_3",
            "start_ms": 244668,
            "end_ms": 245883,
            "text": "А он на Меседе есть?"
          },
          {
            "speaker_id": "speaker_4",
            "start_ms": 247013,
